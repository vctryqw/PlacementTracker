@page
@model PlacementTracker.Pages.Applications.IndexModel

<h1>Applications</h1>

<a asp-page="Create">Add New Application</a>

<form method="get" class="filters">
    <label asp-for="CompanyFilter">Company</label>
    <select asp-for="CompanyFilter" asp-items="new SelectList(Model.Companies)">
        <option value="">All companies</option>
    </select>

    <label asp-for="StatusFilter">Status</label>
    <select asp-for="StatusFilter" asp-items="Html.GetEnumSelectList<ApplicationStatus>()">
        <option value="">All statuses</option>
    </select>

    <button type="submit">Filter</button>
    <a asp-page="Index">Clear</a>
</form>

@if (Model.JobApplications.Count == 0)
{
    <p>No applications match these filters.</p>
}

<table>
    <thead>
        <tr>
            <th>Company</th>
            <th>Position</th>
            <th>Status</th>
            <th>Deadline</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model.JobApplications)
        {
            <tr>
                <td>@app.CompanyName</td>
                <td>@app.Position</td>
                <td><span class="badge @app.Status.ToString().ToLower()">@app.Status</span></td>
                <td>
                    @app.Deadline?.ToString("d MMM yyyy")
                    @if (app.DeadlineLabel != "")
                    {
                        <span class="@app.DeadlineClass">@app.DeadlineLabel</span>
                    }
                </td>
                <td><a asp-page="Edit" asp-route-id="@app.Id">Edit</a></td>
                <td><a asp-page="Delete" asp-route-id="@app.Id">Delete</a></td>
            </tr>
        }
    </tbody>
</table>