@page
@model PlacementTracker.Pages.Applications.IndexModel

<h1>Applications</h1>

<a asp-page="Create">Add New Application</a>

<table>
    <thead>
        <tr>
            <th>Company</th>
            <th>Position</th>
            <th>Status</th>
            <th>Deadline</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var app in Model.JobApplications)
        {
            <tr>
                <td>@app.CompanyName</td>
                <td>@app.Position</td>
                <td><span class="badge @app.Status.ToString().ToLower()">@app.Status</span></td>
                <td>
                    @app.Deadline?.ToString("d MMM yyyy")
                    @if (app.DeadlineLabel != "")
                    {
                        <span class="@app.DeadlineClass">@app.DeadlineLabel</span>
                    }
                </td>
                <td><a asp-page="Edit" asp-route-id="@app.Id">Edit</a></td>
                <td><a asp-page="Delete" asp-route-id="@app.Id">Delete</a></td>
            </tr>
        }
    </tbody>
</table>