@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>Dashboard</h1>
<section class="stats">
    <div class="stat">
        <span class="stat-number">@Model.Total</span>
        <span class="stat-label">Total applications</span>
    </div>
    <div class="stat">
        <span class="stat-number">@Model.Active</span>
        <span class="stat-label">Active</span>
    </div>
    <div class="stat">
        <span class="stat-number">@Model.InterviewsSoon</span>
        <span class="stat-label">Interviews in the next 7 days</span>
    </div>
    <div class="stat">
        <span class="stat-number">@Model.Offers</span>
        <span class="stat-label">Offers</span>
    </div>
</section>

<section class="board">
    @foreach (var status in Model.BoardColumns)
    {
        var appsInColumn = Model.AllApplications.Where(a => a.Status == status).ToList();

        <div class="column">
            <h2>@status <span class="count">@appsInColumn.Count</span></h2>

            @foreach (var app in appsInColumn)
            {
                <a class="card" asp-page="/Applications/Edit" asp-route-id="@app.Id">
                    <div class="card-top">
                        <strong>@app.CompanyName</strong>
                        <span class="badge @app.Status.ToString().ToLower()">@app.Status</span>
                    </div>
                    <div>@app.Position</div>
                    <div class="card-date">
                        @if (app.ApplicationDate != null)
                        {
                            <span>Applied @app.ApplicationDate.Value.ToString("d MMM yyyy")</span>
                        }
                        @if (app.DeadlineLabel != "")
                        {
                            <span class="@app.DeadlineClass">@app.DeadlineLabel</span>
                        }
                    </div>
                </a>
            }
        </div>
    }
</section>

<section class="box">
    <h2>Reminders</h2>

    @if (Model.RemindersDue.Count == 0)
    {
        <p>No reminders due today.</p>
    }
    else
    {
        <ul>
            @foreach (var app in Model.RemindersDue)
            {
                <li>
                    <strong>@app.CompanyName</strong> – @app.Position
                    <br />
                    @(app.ReminderNote ?? "Check on this application")

                    <form method="post" asp-page-handler="Dismiss" asp-route-id="@app.Id" class="inline-form">
                        <button type="submit">Done</button>
                    </form>
                </li>
            }
        </ul>
    }
</section>

<section class="box">
    <h2>Deadlines in the next 2 weeks</h2>

    @if (Model.UpcomingDeadlines.Count == 0)
    {
        <p>Nothing due in the next 14 days.</p>
    }
    else
    {
        <ul>
            @foreach (var app in Model.UpcomingDeadlines)
            {
                <li>
                    <a asp-page="/Applications/Edit" asp-route-id="@app.Id">
                        <strong>@app.CompanyName</strong> – @app.Position
                    </a>
                    <br />
                    @app.Deadline?.ToString("ddd d MMM")
                    <span class="@app.DeadlineClass">@app.DeadlineLabel</span>
                </li>
            }
        </ul>
    }
</section>