@page "{id:int}"
@model PlacementTracker.Pages.Applications.DeleteModel

<h1>Delete Application</h1>

<p>Are you sure you want to delete this application?</p>

<p><strong>@Model.JobApplication.Position</strong> at <strong>@Model.JobApplication.CompanyName</strong></p>
<p>Status: @Model.JobApplication.Status</p>

<form method ="post">
    <button type="submit">Yes, delete it</button>
    <a asp-page="Index">Cancel</a>
</form>